# EC2 app: productor y Kafka Streams
# Copiar a app.env y ajustar la IP privada del host y los brokers.
KAFKA_BOOTSTRAP=10.10.0.33:9092,10.10.0.126:9092
RAW_TOPIC=ventas-raw
AGG_TOPIC=ventas-agregadas
DLQ_TOPIC=ventas-raw-dlq
GROUP_ID=ventas-aggregator
WINDOW_SECONDS=60
WINDOW_GRACE_SECONDS=30
PRODUCE_INTERVAL=1.0
PRODUCER_MAX_EVENTS=0
PRODUCE_MODE=valid
SCENARIO_EVERY=10
LATE_SECONDS=180
CUSTOMER_POOL=200
APP_PRIVATE_IP=10.10.0.25

# Deduplicación por eventId (se activa en la iteración M2)
DEDUPE_RETENTION_SECONDS=604800
