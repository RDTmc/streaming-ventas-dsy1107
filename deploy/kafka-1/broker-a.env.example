# EC2 kafka-1 (ZooKeeper + broker 1)
# Copiar a broker-a.env y ajustar las IPs privadas del laboratorio.
BROKER_ID=1
BROKER_PRIVATE_IP=10.10.0.33
ZK_CONNECT=10.10.0.33:2181
KAFKA_BOOTSTRAP=10.10.0.33:9092,10.10.0.126:9092

# Kafka UI (solo se levanta con --profile ui)
KAFKA_UI_USERNAME=admin
KAFKA_UI_PASSWORD=replace-with-a-strong-password
